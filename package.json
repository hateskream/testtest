{
  "name": "i88-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "is-ci || husky install",
    "lint:ts": "vue-tsc --pretty --noEmit -p tsconfig.app.json",
    "lint:js:ox": "oxlint src",
    "lint:js:eslint": "eslint src --ext .vue",
    "lint:css": "stylelint \"src/**/*.{vue,css}\"",
    "lint": "concurrently \"npm:lint:*(!fix)\" ",
    "lint:fix": "concurrently \"npm:lint:js:ox -- --fix\" \"npm:lint:js:eslint -- --fix\" \"npm:lint:css -- --fix\""
  },
