{
  "name": "i88-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint:ts": "vue-tsc --pretty --noEmit -p tsconfig.app.json",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.cjs,.mjs",
    "lint:css": "stylelint \"src/**/*.{vue,css}\"",
    "lint": "concurrently \"npm:lint:*(!fix)\" ",
    "lint:fix": "concurrently \"eslint . --ext .js,.jsx,.ts,.tsx,.vue,.cjs,.mjs --fix\" \"stylelint \\\"src/**/*.{vue,css}\\\" --fix\""
  },
  "dependencies": {
    "@floating-ui/vue": "1.1.6",
    "@tanstack/vue-query": "5.67.3",
    "@vueuse/core": "13.0.0",
    "chart.js": "4.4.9",
    "date-fns": "4.1.0",
    "decimal.js": "10.5.0",
    "fancy-canvas": "2.1.0",
    "focus-lock": "1.3.6",
    "grid-layout-plus": "1.0.6",
    "lightweight-charts": "5.0.6",
    "ofetch": "1.4.1",
    "pinia": "3.0.1",
    "technicalindicators": "3.1.0",
    "vue": "3.5.13",
    "vue-eslint-parser": "10.1.3",
    "vue-router": "4.5.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "4.2.0",
    "@tanstack/vue-query-devtools": "5.67.3",
    "@types/node": "22.13.10",
    "@typescript-eslint/parser": "8.32.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/tsconfig": "0.7.0",
    "concurrently": "9.1.2",
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.1.3",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-n": "17.17.0",
    "eslint-plugin-vue": "10.1.0",
    "globals": "16.0.0",
    "husky": "8.0.0",
    "postcss": "8.5.3",
    "postcss-html": "1.5.0",
    "prettier": "3.2.5",
    "stylelint": "14.16.1",
    "stylelint-config-standard": "29.0.0",
    "stylelint-order": "5.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.32.0",
    "vite": "6.3.5",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "7.7.6",
    "vite-svg-loader": "5.1.0",
    "vue-tsc": "2.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  }
